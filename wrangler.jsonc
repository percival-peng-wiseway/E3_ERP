{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "e3-erp",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "ERP_DB",
      "database_name": "e3-erp-prod",
      "database_id": "fce8d663-dfe8-4957-9f12-1e7f4f8a5414",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ERP_FILES",
      "id": "b157693bb7ba480d97fd41894e26184a"
    }
  ],
  "ai_search": [
    {
      "binding": "KNOWLEDGE_SEARCH",
      "instance_name": "erp",
      "remote": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "INVENTORY_OPERATIONS_API_URL": "https://inventory.e3energy.com.au/api/inventory",
    "QUOTEHELP_APP_URL": "https://quote.e3energy.com.au",
    "AGENT_BASE_URL": "https://navigator-spongy-diagnosis.ngrok-free.dev/v1",
    "AGENT_MODEL": "qwen3.5:9b",
    "DEEPSEEK_BASE_URL": "https://api.deepseek.com/beta",
    "DEEPSEEK_MODEL_FAST": "deepseek-v4-flash",
    "DEEPSEEK_MODEL_COMPLEX": "deepseek-v4-pro"
  }
}

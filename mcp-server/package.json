{
  "name": "erp-agent-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only MCP server for the ERP inventory and quotation modules.",
  "type": "module",
  "bin": {
    "erp-agent-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",

# Optional private local folder for the saved Agent configuration.
AGENT_SETTINGS_DATA_DIR=
# Optional private local folder for E3 Group discussion messages.
GROUP_CHAT_DATA_DIR=

# Kimi K2.6 powers Home Agent model answers, image understanding and the
# read-only Business Agent through Moonshot's OpenAI-compatible /v1 endpoint.
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL_NAME=kimi-k2.6

# Langfuse v5 tracing. Keep disabled until keys are configured and a preview
# trace has been inspected. Raw ERP prompt/answer capture is off by default.
LANGFUSE_TRACING_ENABLED=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=
LANGFUSE_CAPTURE_CONTENT=0
LANGFUSE_SESSION_HASH_SALT=

# Server-side upstreams used by the native inventory and QuoteHelp modules.
# The browser only calls same-origin /api/inventory/operations and /api/quotehelp/* routes.
INVENTORY_OPERATIONS_API_URL=https://inventory.e3energy.com.au/api/inventory
QUOTEHELP_APP_URL=https://quote.e3energy.com.au

# Optional bearer token for trusted non-browser writes to the operational proxies.
# Browser writes require a valid employee session and a verifiably same-origin request.
ERP_INTERNAL_API_TOKEN=

# Required in production for signed employee login sessions. Use at least 32 random characters.
ERP_AUTH_SESSION_SECRET=

# Optional read-only data sources for the home summary and retained Agent/MCP API.
# They are separate from the native operational modules above.
ERP_INVENTORY_API_URL=
ERP_QUOTATION_API_URL=
ERP_API_TOKEN=
# Legacy optional external adapters used by POST /api/agent/chat. The deployed
# knowledge tool uses the same Worker AI Search binding and does not self-call.
ERP_KNOWLEDGE_API_URL=
ERP_PROJECT_API_URL=
ERP_ORDER_API_URL=

# Optional private local directory for knowledge metadata/chunks/jobs.
# Cloudflare production uses ERP_DB instead.
KNOWLEDGE_DATA_DIR=

# Local Reimbursements workspace. Use durable database/object storage before cloud deployment.
REIMBURSEMENT_DATA_DIR=
REIMBURSEMENT_ADMIN_PASSWORD=
# Required in production; use a separate random value of at least 32 characters.
REIMBURSEMENT_SESSION_SECRET=

# Optional local storage folder for the shared Reports needs document.
REPORTS_DATA_DIR=

# Optional local storage folder for Admin-managed public announcements.
# Replace with D1 or KV before Cloudflare production deployment.
ANNOUNCEMENTS_DATA_DIR=

# Local Project Track records, agreements and payment proofs.
# Admin approvals reuse the reimbursement administrator password/session secret above.
PAYMENT_TRACK_DATA_DIR=
# Keep false while repeated Proposal uploads are needed for testing. Set true to restore duplicate blocking.
PAYMENT_TRACK_ENFORCE_UNIQUE_PROPOSAL=false

# Local Site Visiting records and photos. Replace with durable database/object storage before cloud deployment.
SITE_VISIT_DATA_DIR=

# Copy this file to .dev.vars for local Cloudflare preview only.
# Never commit the real values.
NEXTJS_ENV=development
ERP_AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
ERP_INTERNAL_API_TOKEN=replace-with-a-long-random-value
MOONSHOT_API_KEY=replace-with-your-moonshot-api-key
KIMI_REGION=china
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL_NAME=kimi-k2.6
KIMI_PLANNER_MODEL_NAME=kimi-k3
KIMI_EXECUTOR_MODEL_NAME=kimi-k2.6
# Legacy external adapter only; normal retrieval uses Workers AI + Vectorize bindings.
ERP_KNOWLEDGE_API_URL=
ERP_PROJECT_API_URL=
ERP_ORDER_API_URL=
# Optional Node-local metadata/chunk/job directory (not used by Worker production).
KNOWLEDGE_DATA_DIR=
REIMBURSEMENT_ADMIN_PASSWORD=replace-with-a-strong-password
REIMBURSEMENT_SESSION_SECRET=replace-with-at-least-32-random-characters

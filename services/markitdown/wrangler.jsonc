{
  "name": "e3-markitdown",
  "main": "worker.ts",
  "compatibility_date": "2026-09-10",
  "workers_dev": false,
  "preview_urls": false,
  "containers": [{"class_name":"Converter","image":"./Dockerfile","max_instances":1,"instance_type":"basic"}],
  "durable_objects": {"bindings":[{"name":"CONVERTER","class_name":"Converter"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["Converter"]}],
  "observability":{"enabled":true}
}

{
  "name": "unify-erp-workspace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:migrate": "wrangler d1 migrations apply e3-erp-prod --remote",
    "predeploy": "npm run cf:migrate",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:deploy-built": "npm run cf:migrate && opennextjs-cloudflare deploy",
    "preupload": "npm run cf:migrate",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf:migrate-local-data": "node scripts/migrate-cloudflare-data.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "mcp:dev": "npm --prefix mcp-server run dev",
    "mcp:build": "npm --prefix mcp-server run build"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "lucide-react": "^0.468.0",
    "next": "^16.3.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.125.0"
  }
}
